<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 图书借阅系统后台管理</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/header') %>

<% if (message) { %>
<div class="banner <%= messageType %>">
  <span class="icon"><%= messageType === 'error' ? '✕' : '✓' %></span><%= message %>
</div>
<% } %>

<div class="toolbar">
  <form method="get" action="/books" class="toolbar">
    <label for="bookName">图书名称:</label>
    <input type="text" id="bookName" name="bookName" placeholder="请输入图书名称" value="<%= bookName %>">
    <button type="submit" class="btn btn-primary">查询</button>
  </form>
  <div class="spacer"></div>
  <a href="/books/new" class="btn btn-primary">+ 新增图书</a>
</div>

<div class="table-wrap">
  <table>
    <colgroup>
      <col style="width:56px"><col style="width:100px"><col style="width:170px"><col style="width:80px"><col style="width:140px"><col style="width:160px"><col style="width:110px"><col style="width:90px"><col style="width:110px"><col style="width:140px">
    </colgroup>
    <thead>
      <tr>
        <th>序号</th><th>图书编号</th><th>图书名称</th><th>图书类型</th><th>作者</th><th>出版社</th><th>出版日期</th><th>是否借阅</th><th>入库时间</th><th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (books.length === 0) { %>
      <tr class="empty-row"><td colspan="10">暂无符合条件的图书信息</td></tr>
      <% } %>
      <% books.forEach(function (book, i) { %>
      <tr>
        <td><%= (page - 1) * pageSize + i + 1 %></td>
        <td><%= book.bookCode %></td>
        <td><%= book.bookName %></td>
        <td><%= book.type ? book.type.typeName : '-' %></td>
        <td><%= book.bookAuthor %></td>
        <td><%= book.publishPress %></td>
        <td><%= book.publishDate %></td>
        <td>
          <% if (book.borrowed === 1) { %>
          <span class="badge badge-out">已借阅</span>
          <% } else { %>
          <span class="badge badge-ok">未借阅</span>
          <% } %>
        </td>
        <td><%= book.creationTime %></td>
        <td>
          <a class="link" href="/books/<%= book.bookId %>?bookName=<%= encodeURIComponent(bookName) %>&page=<%= page %>">查看</a>
          <a class="link" href="/books/<%= book.bookId %>/edit?bookName=<%= encodeURIComponent(bookName) %>&page=<%= page %>">修改</a>
          <form class="js-delete-form" method="post" action="/books/<%= book.bookId %>/delete" style="display:inline">
            <input type="hidden" name="_bookName" value="<%= bookName %>">
            <input type="hidden" name="_page" value="<%= page %>">
            <button type="submit" class="link link-danger">删除</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="pager">
  <span>共 <%= count %> 条记录,每页 <%= pageSize %> 条</span>
  <div class="pages">
    <% if (page > 1) { %>
    <a class="pg" href="<%= listUrl(bookName, 1) %>">首页</a>
    <a class="pg" href="<%= listUrl(bookName, page - 1) %>">上一页</a>
    <% } else { %>
    <span class="pg disabled">首页</span>
    <span class="pg disabled">上一页</span>
    <% } %>
    <% for (var p = 1; p <= totalPages; p++) { %>
      <% if (p === page) { %>
      <span class="pg active"><%= p %></span>
      <% } else { %>
      <a class="pg" href="<%= listUrl(bookName, p) %>"><%= p %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %>
    <a class="pg" href="<%= listUrl(bookName, page + 1) %>">下一页</a>
    <a class="pg" href="<%= listUrl(bookName, totalPages) %>">末页</a>
    <% } else { %>
    <span class="pg disabled">下一页</span>
    <span class="pg disabled">末页</span>
    <% } %>
  </div>
</div>

<script src="/js/jquery.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
